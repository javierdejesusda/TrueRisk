# Additions for gp.nano hosts. Apply on top of .env.production.example values.
# Populate Dokploy's compose env block with .env.production's full set, then
# extend/override with the keys below. Do not commit a populated copy.

# Backend kill-switches (matches docker-compose.nano.yml).
WORKERS=1
ENABLE_SCHEDULER=false
ENABLE_TFT_FORECASTS=false

# Reduce Sentry traffic so the free tier is never exhausted at 1-2 users.
SENTRY_TRACES_SAMPLE_RATE=0.01
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.01

# OPENAI_API_KEY intentionally left empty: AI summaries, chat, suggestions,
# narrative, and emergency-plan endpoints return HTTP 503. The frontend
# renders a low-maintenance notice in place of those features (wired in a
# follow-up commit).
OPENAI_API_KEY=
